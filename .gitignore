# Local env — keep real secrets out of git.
# NOTE: .env.production IS committed on purpose: it holds only PUBLIC client
# config (Supabase URL + anon key + worker URL) that ships in the app anyway,
# and Codemagic needs it to build. Keep the GitHub repo PRIVATE.
.env
.env.local
.env.*.local

